<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="InterfaceBuilderBannerViewController" customModule="UIKitSample" customModuleProvider="target">
            <connections>
                <outlet property="bannerContentView" destination="IBB-00-001" id="IBB-cn-001"/>
                <outlet property="bannerView" destination="IBB-00-002" id="IBB-cn-002"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="IBB-00-001">
            <rect key="frame" x="0.0" y="0.0" width="320" height="60"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <!-- 여기가 핵심: Class = AdWhaleMediationAdView, Module = AdWhaleSDK -->
                <view contentMode="scaleToFill" customClass="AdWhaleMediationAdView" customModule="AdWhaleSDK" translatesAutoresizingMaskIntoConstraints="NO" id="IBB-00-002">
                    <rect key="frame" x="0.0" y="5" width="320" height="50"/>
                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                    <constraints>
                        <constraint firstAttribute="width" constant="320" id="IBB-cs-001"/>
                        <constraint firstAttribute="height" constant="50" id="IBB-cs-002"/>
                    </constraints>
                </view>
            </subviews>
            <color key="backgroundColor" systemColor="tertiarySystemBackgroundColor"/>
            <constraints>
                <constraint firstItem="IBB-00-002" firstAttribute="centerX" secondItem="IBB-00-001" secondAttribute="centerX" id="IBB-cs-003"/>
                <constraint firstItem="IBB-00-002" firstAttribute="centerY" secondItem="IBB-00-001" secondAttribute="centerY" id="IBB-cs-004"/>
            </constraints>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </view>
    </objects>
    <resources>
        <systemColor name="tertiarySystemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
