// ─────────────────────────────────────────────────────────────
// AdWhale.xcconfig — 샘플 앱이 사용하는 키 모음
//
// Android 샘플의 app/src/main/res/values/strings.xml 에 대응한다.
//
//   Android                                      │ iOS (이 샘플)
//   ─────────────────────────────────────────────┼──────────────────────────────
//   strings.xml <string name="publisher_uid">    │ ADWHALE_PUBLISHER_UID
//   AndroidManifest <meta-data ...PUBLISHER_UID> │ Info.plist 변수 치환
//   R.string.banner32050_placementUid            │ ADWHALE_PLACEMENT_BANNER
//   local.properties (git 미추적)                 │ Config/Local.xcconfig (git 미추적)
//
// 값 전달 경로: xcconfig → Info.plist 변수 치환 → SampleConfig(Swift)
//
// ⚠️ xcconfig 는 `//` 를 주석 시작으로 해석한다. 값에 `//` 가 들어가면 잘리므로
//    URL 은 넣지 말 것. (여기서는 UID / App ID 만 다룬다)
//
// ⚠️ 아래 값은 모두 자리표시자다. 실제 키로 바꾸지 않으면 광고가 나오지 않는다.
//    · ADWHALE_* : ADwhale Mediation SDK 가이드 문서의 키값을 참고하거나
//                  AdWhale 미디에이션 콘솔에서 발급받는다.
//    · ADWHALE_ADMOB_APP_ID : Google AdMob 콘솔에서 발급받는다.
// ─────────────────────────────────────────────────────────────

// Publisher UID — Info.plist 의 net.adwhale.sdk.mediation.PUBLISHER_UID 로 주입된다.
ADWHALE_PUBLISHER_UID = ADwhale Mediation SDK 가이드 내 키값 참조

// 지면(Placement) UID — 애드폼별로 발급된다.
ADWHALE_PLACEMENT_BANNER       = ADwhale Mediation SDK 가이드 내 키값 참조
ADWHALE_PLACEMENT_INTERSTITIAL = ADwhale Mediation SDK 가이드 내 키값 참조
ADWHALE_PLACEMENT_REWARD       = ADwhale Mediation SDK 가이드 내 키값 참조
ADWHALE_PLACEMENT_NATIVE       = ADwhale Mediation SDK 가이드 내 키값 참조
ADWHALE_PLACEMENT_APP_OPEN     = ADwhale Mediation SDK 가이드 내 키값 참조
ADWHALE_PLACEMENT_POPUP        = ADwhale Mediation SDK 가이드 내 키값 참조

// AdMob 앱 ID — Info.plist 의 GADApplicationIdentifier 로 주입된다.
// AdMob 어댑터를 링크하면 이 키가 없을 때 GoogleMobileAds 가 실행 시점에 크래시한다.
ADWHALE_ADMOB_APP_ID = Google AdMob 에서 발급한 키값

// 로컬 전용 오버라이드 (git 미추적). 파일이 없으면 무시된다.
// Android 의 local.properties 와 같은 역할이므로 반드시 마지막에 include 한다.
#include? "Local.xcconfig"
